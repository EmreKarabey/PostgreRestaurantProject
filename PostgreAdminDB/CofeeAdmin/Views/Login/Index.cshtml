@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap | Dina Kafe";
}

<!DOCTYPE html>
<html lang="tr" class="h-full">
@await Html.PartialAsync("/Views/PartialView/HeadPartialView.cshtml")

<style>
    /* Input ve butonların iç odaklanma çizgilerini (outline/border) kaldır */
    input:focus, input:focus-visible, 
    button:focus, button:focus-visible {
        outline: none !important;
        box-shadow: none !important;
        border: none !important;
    }
</style>

<body class="admin-login-page h-full min-h-screen text-ink font-sans antialiased relative flex items-center justify-center p-4 selection:bg-brand-500 selection:text-white overflow-hidden">

    <!-- ============ TAM EKRAN KAHVE ARKA PLANI ============ -->
    <div class="fixed inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=1920&auto=format&fit=crop&q=85" 
             alt="Dina Kafe" 
             class="w-full h-full object-cover scale-105" />
        <!-- Karartma ve Sıcak Espresso Gradyan Katmanı -->
        <div class="absolute inset-0 bg-gradient-to-tr from-ink/90 via-ink/75 to-ink/65 backdrop-blur-[2px]"></div>
        <!-- İnce Altın Işıma Efekti -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-brand-500/15 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- ============ ORTALANMIŞ ŞIK GLASSMORPHIC GİRİŞ KARTI ============ -->
    <div class="admin-login-shell relative z-10 w-full max-w-[480px]"
         x-data="{ 
            username: '',
            password: '',
            showPassword: false,
            rememberMe: false,
            isSubmitting: false
         }">

        <div class="admin-login-card bg-card/95 backdrop-blur-xl border border-line/80 rounded-3xl p-10 sm:p-12 shadow-2xl shadow-ink/50 space-y-8">

            <!-- Marka ve Başlık -->
            <div class="text-center space-y-3">
                <div class="inline-flex w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white items-center justify-center shadow-lg shadow-brand-900/30 border border-brand-400/30">
                    <svg class="w-7 h-7 text-brand-50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                        <path d="M6 1v3M10 1v3M14 1v3" stroke-linecap="round"/>
                    </svg>
                </div>
                <div>
                    <h1 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-ink">
                        Dina Kafe
                    </h1>
                    <p class="text-xs text-ink-soft mt-1">
                        Yönetim Paneli Girişi
                    </p>
                </div>
            </div>

            <!-- Hata Bildirimleri -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="p-3.5 rounded-xl border border-bad/30 bg-bad/10 text-bad text-xs font-semibold flex items-center gap-2.5 shadow-xs">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <!-- Form -->
            <form method="post" action="/Login/Index" @@submit="isSubmitting = true" class="space-y-8 pt-2">

                <!-- 1. Kullanıcı Adı veya E-Posta -->
                <div class="space-y-1.5">
                    <label for="username" class="block text-xs font-semibold text-ink uppercase tracking-wider">
                        Kullanıcı Adı veya E-Posta
                    </label>
                    <div class="flex items-center rounded-xl border border-line bg-paper/60 focus-within:bg-card focus-within:ring-2 focus-within:ring-brand-500/40 focus-within:border-brand-500 transition-all overflow-hidden shadow-2xs">
                        <span class="pl-3.5 pr-2 text-ink-soft shrink-0">
                            <svg class="w-4 h-4 text-ink-soft" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                        </span>
                        <input type="text" 
                               id="username" 
                               name="username" 
                               x-model="username"
                               required 
                               autocomplete="username"
                               placeholder="Kullanıcı adı veya e-posta" 
                               style="outline: none !important; border: none !important; box-shadow: none !important;"
                               class="w-full px-2 py-3 text-sm font-medium text-ink bg-transparent placeholder:text-ink-soft/40 border-0 outline-none focus:outline-none">
                    </div>
                </div>
                <!-- 2. Şifre -->
                <div class="space-y-1.5 pt-2">
                    <label for="password" class="block text-xs font-semibold text-ink uppercase tracking-wider">
                        Şifre
                    </label>
                    <div class="flex items-center rounded-xl border border-line bg-paper/60 focus-within:bg-card focus-within:ring-2 focus-within:ring-brand-500/40 focus-within:border-brand-500 transition-all overflow-hidden shadow-2xs">
                        <span class="pl-3.5 pr-2 text-ink-soft shrink-0">
                            <svg class="w-4 h-4 text-ink-soft" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </span>
                        <input :type="showPassword ? 'text' : 'password'" 
                               id="password" 
                               name="password" 
                               x-model="password"
                               required 
                               autocomplete="current-password"
                               placeholder="Şifreniz" 
                               style="outline: none !important; border: none !important; box-shadow: none !important;"
                               class="w-full px-2 py-3 text-sm font-medium text-ink bg-transparent placeholder:text-ink-soft/40 border-0 outline-none focus:outline-none">
                        
                        <!-- Şifreyi Göster/Gizle Butonu -->
                        <button type="button" 
                                @@click="showPassword = !showPassword"
                                style="outline: none !important; border: none !important; box-shadow: none !important;"
                                class="pr-3.5 pl-2 text-ink-soft hover:text-ink transition-colors cursor-pointer border-0 outline-none"
                                tabindex="-1">
                            <svg x-show="showPassword" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            <svg x-show="!showPassword" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- 3. Beni Hatırla -->
                <div class="pt-1">
                    <label class="inline-flex items-center gap-2 cursor-pointer select-none group">
                        <input type="checkbox" 
                               id="rememberMe" 
                               name="rememberMe" 
                               value="true" 
                               x-model="rememberMe"
                               class="w-4 h-4 rounded border-line text-brand-500 focus:ring-brand-500/40 cursor-pointer accent-brand-500">
                        <span class="text-xs font-medium text-ink-soft group-hover:text-ink transition-colors">
                            Beni Hatırla
                        </span>
                    </label>
                </div>

                <!-- 4. Giriş Yap Butonu -->
                <div class="pt-2">
                    <button type="submit" 
                            :disabled="isSubmitting"
                            class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-brand-600 via-brand-500 to-brand-600 hover:from-brand-500 hover:to-brand-600 text-white font-semibold text-sm shadow-md hover:shadow-lg hover:shadow-brand-500/25 transition-all duration-200 active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer disabled:opacity-75">
                        
                        <svg x-show="isSubmitting" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>

                        <span x-text="isSubmitting ? 'Giriş Yapılıyor...' : 'Giriş Yap'"></span>
                    </button>
                </div>

            </form>

        </div>

    </div>

</body>
</html>
