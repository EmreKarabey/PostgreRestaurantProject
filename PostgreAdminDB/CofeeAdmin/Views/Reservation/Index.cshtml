@using EntityLayer.Entities
@using System.Collections.Generic
@using X.PagedList
@model IPagedList<Reservation>

@{
    ViewData["Title"] = "Rezervasyonlar";
    Layout = "_Layout";

    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
    var reservationProfileImages = ViewBag.ReservationProfileImages as Dictionary<string, string>
        ?? new Dictionary<string, string>();
    var totalCount = ViewBag.TotalReservations ?? 0;
    var activeCount = ViewBag.ActiveReservations ?? 0;
    var softDeletedCount = ViewBag.SoftDeletedReservations ?? 0;
    var upcomingCount = ViewBag.UpcomingReservations ?? 0;
    var totalPeople = ViewBag.TotalPeople ?? 0;
}

<div class="space-y-8">

    <!-- ============ SAYFA ÜST BAŞLIĞI VE AKSİYONLAR ============ -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-2 border-b border-line/70">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="font-display text-3xl font-bold tracking-tight text-ink">Rezervasyon Listesi</h1>
                <span class="text-xs font-sans font-semibold px-2.5 py-1 rounded-full bg-brand-100 text-brand-700">
                    @totalCount Rezervasyon
                </span>
            </div>
            <p class="text-sm text-ink-soft mt-1">
                Restoran rezervasyonlarını görüntüleyin, yeni rezervasyon açın ve soft delete (arşive alma/geri yükleme) durumlarını yönetin.
            </p>
        </div>

        <!-- Aksiyon Butonları -->
        <div class="flex items-center gap-3 shrink-0">
            <a href="/Reservation/Index?filter=@currentFilter" class="btn btn-ghost text-xs" title="Sayfayı Yenile">
                <svg class="w-4 h-4 text-ink-soft" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 12a9 9 0 1 1-3-6.7M21 4v5h-5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>Yenile</span>
            </a>
            <a href="/Reservation/AddReservation" class="btn btn-primary text-xs shadow-xs">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>Yeni Rezervasyon Ekle</span>
            </a>
        </div>
    </div>

    <!-- ============ İSTATİSTİK ÖZET KARTLARI ============ -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
        <!-- Toplam Rezervasyon -->
        <div class="bg-card border border-line rounded-xl p-5 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-ink-soft">Toplam Rezervasyon</span>
                <span class="w-8 h-8 rounded-lg bg-brand-50 text-brand-700 grid place-items-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="font-display text-3xl font-bold text-ink" id="stat-total-count">@totalCount</span>
                <span class="text-xs text-ink-soft">kayıt</span>
            </div>
            <div class="mt-2 text-xs text-ink-soft flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-brand-500"></span>
                <span>Tüm rezervasyonlar</span>
            </div>
        </div>

        <!-- Aktif / Geçerli Rezervasyonlar -->
        <div class="bg-card border border-line rounded-xl p-5 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-ink-soft">Aktif Rezervasyon</span>
                <span class="w-8 h-8 rounded-lg bg-ok/15 text-ok grid place-items-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke-linecap="round"/>
                        <path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="font-display text-3xl font-bold text-ok" id="stat-active-count">@activeCount</span>
                <span class="text-xs text-ok/80 font-medium">aktif</span>
            </div>
            <div class="mt-2 text-xs text-ink-soft flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-ok"></span>
                <span>Silinmemiş &amp; Geçerli</span>
            </div>
        </div>

        <!-- Soft Delete / Arşiv -->
        <div class="bg-card border border-line rounded-xl p-5 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-ink-soft">Soft Silinenler</span>
                <span class="w-8 h-8 rounded-lg bg-warn/15 text-warn grid place-items-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="font-display text-3xl font-bold text-warn" id="stat-soft-deleted-count">@softDeletedCount</span>
                <span class="text-xs text-warn/80 font-medium">arşivde</span>
            </div>
            <div class="mt-2 text-xs text-ink-soft flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-warn"></span>
                <span>Soft Delete uygulanmış</span>
            </div>
        </div>

        <!-- Yaklaşan / Toplam Misafir -->
        <div class="bg-card border border-line rounded-xl p-5 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-ink-soft">Yaklaşan Rezervasyon</span>
                <span class="w-8 h-8 rounded-lg bg-ink text-brand-100 grid place-items-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="font-display text-3xl font-bold text-ink">@upcomingCount</span>
                <span class="text-xs text-ink-soft">(@totalPeople kişi)</span>
            </div>
            <div class="mt-2 text-xs text-ink-soft flex items-center gap-1.5">
                <span class="text-brand-600 font-semibold">Gelecek tarihliler</span>
            </div>
        </div>
    </div>

    <!-- ============ FİLTRELEME SEKMELERİ ============ -->
    <div class="flex items-center gap-2 border-b border-line pb-3">
        <a href="/Reservation/Index?filter=all" 
           class="px-4 py-2 rounded-lg text-xs font-semibold transition-all @(currentFilter == "all" ? "bg-brand-500 text-white shadow-xs" : "bg-card border border-line text-ink-soft hover:text-ink hover:bg-brand-50")">
            Tüm Kayıtlar (@totalCount)
        </a>
        <a href="/Reservation/Index?filter=active" 
           class="px-4 py-2 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 @(currentFilter == "active" ? "bg-ok text-white shadow-xs" : "bg-card border border-line text-ink-soft hover:text-ink hover:bg-brand-50")">
            <span class="w-1.5 h-1.5 rounded-full @(currentFilter == "active" ? "bg-white" : "bg-ok")"></span>
            Aktif Rezervasyonlar (@activeCount)
        </a>
        <a href="/Reservation/Index?filter=deleted" 
           class="px-4 py-2 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 @(currentFilter == "deleted" ? "bg-warn text-white shadow-xs" : "bg-card border border-line text-ink-soft hover:text-ink hover:bg-brand-50")">
            <span class="w-1.5 h-1.5 rounded-full @(currentFilter == "deleted" ? "bg-white" : "bg-warn")"></span>
            Soft Silinenler / Arşiv (@softDeletedCount)
        </a>
    </div>

    <!-- ============ REZERVASYON VERİ TABLOSU ============ -->
    <div class="bg-card border border-line rounded-xl shadow-xs">
        <div class="overflow-x-auto min-h-[220px] lg:overflow-visible">
            <table class="w-full text-left text-sm">
                <!-- Tablo Başlıkları -->
                <thead class="text-xs font-semibold text-ink-soft bg-brand-50/70 border-b border-line uppercase tracking-wider">
                    <tr>
                        <th class="px-6 py-3.5 w-16">ID</th>
                        <th class="px-6 py-3.5">Müşteri</th>
                        <th class="px-6 py-3.5">İletişim</th>
                        <th class="px-6 py-3.5">Rezervasyon Tarihi</th>
                        <th class="px-6 py-3.5 text-center">Masa &amp; Kişi</th>
                        <th class="px-6 py-3.5 text-center">Soft Delete Durumu</th>
                        <th class="px-6 py-3.5 text-right w-24">İşlemler</th>
                    </tr>
                </thead>

                <!-- Tablo Satırları -->
                <tbody class="divide-y divide-line">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var isDeleted = item.DeletedAt != null;
                            var isPast = item.ReservationDate < DateTime.UtcNow;
                            var normalizedEmail = item.Email?.Trim().ToUpperInvariant();
                            var profileImageUrl = normalizedEmail != null
                                && reservationProfileImages.TryGetValue(normalizedEmail, out var storedImageUrl)
                                ? $"/Image/Get?url={Uri.EscapeDataString(storedImageUrl)}&thumbnail=true"
                                : null;

                            <tr id="reservation-row-@item.EntityID" class="hover:bg-brand-50/40 transition-all duration-300 @(isDeleted ? "opacity-75 bg-warn/5" : "")">
                                <!-- ID -->
                                <td class="px-6 py-4 font-mono text-xs text-ink-soft">
                                    #@item.EntityID
                                </td>

                                <!-- Müşteri Adı & Soyadı -->
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(profileImageUrl))
                                        {
                                            <img src="@profileImageUrl" alt="@item.FirstName @item.LastName" class="w-10 h-10 rounded-full object-cover border border-line shrink-0" />
                                        }
                                        <div>
                                            <span class="font-display font-semibold text-ink text-base block">@item.FirstName @item.LastName</span>
                                            <span class="text-xs text-ink-soft font-sans">#REZ-@item.EntityID</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- İletişim (Email & Telefon) -->
                                <td class="px-6 py-4">
                                    <div class="space-y-1">
                                        <a href="mailto:@item.Email" class="text-xs text-ink-soft hover:text-brand-600 flex items-center gap-1.5 transition-colors">
                                            <svg class="w-3.5 h-3.5 shrink-0 text-brand-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                            </svg>
                                            <span class="truncate max-w-[160px]">@item.Email</span>
                                        </a>
                                        <a href="tel:@item.PhoneNumber" class="text-xs font-mono text-ink-soft hover:text-brand-600 flex items-center gap-1.5 transition-colors">
                                            <svg class="w-3.5 h-3.5 shrink-0 text-brand-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                                <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                            </svg>
                                            <span>@item.PhoneNumber</span>
                                        </a>
                                    </div>
                                </td>

                                <!-- Rezervasyon Tarihi -->
                                <td class="px-6 py-4">
                                    <div class="space-y-0.5">
                                        <div class="font-medium text-xs text-ink flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5 text-brand-600 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                                <circle cx="12" cy="12" r="10"/>
                                                <polyline points="12 6 12 12 16 14"/>
                                            </svg>
                                            <span>@item.ReservationDate.ToLocalTime().ToString("dd MMMM yyyy, HH:mm", new System.Globalization.CultureInfo("tr-TR"))</span>
                                        </div>
                                        <div>
                                            @if (isPast)
                                            {
                                                <span class="text-[10px] font-semibold text-ink-soft bg-black/5 px-2 py-0.5 rounded">Geçmiş Tarih</span>
                                            }
                                            else
                                            {
                                                <span class="text-[10px] font-semibold text-ok bg-ok/10 px-2 py-0.5 rounded">Yaklaşan</span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Masa & Kişi Sayısı -->
                                <td class="px-6 py-4 text-center">
                                    <div class="flex flex-col items-center gap-1">
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-100">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <rect x="3" y="4" width="18" height="12" rx="2"/>
                                                <path d="M7 16v4M17 16v4"/>
                                            </svg>
                                            @(item.TableNumber.HasValue ? $"Masa #{item.TableNumber}" : "Masa Atanmadı")
                                        </span>
                                        <span class="text-xs text-ink-soft font-medium flex items-center gap-1">
                                            <svg class="w-3 h-3 text-ink-soft" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                                <circle cx="9" cy="7" r="4"/>
                                            </svg>
                                            @item.NumberOfPeople Kişi
                                        </span>
                                    </div>
                                </td>

                                <!-- Durum (Soft Delete Durumu) -->
                                <td class="px-6 py-4 text-center" id="reservation-status-cell-@item.EntityID">
                                    <span id="status-badge-@item.EntityID" 
                                          data-deleted="@(isDeleted ? "true" : "false")" 
                                          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold @(isDeleted ? "bg-warn/15 text-warn" : "bg-ok/15 text-ok") transition-all duration-300">
                                        <span class="w-1.5 h-1.5 rounded-full @(isDeleted ? "bg-warn" : "bg-ok animate-pulse")"></span>
                                        <span id="status-text-@item.EntityID">@(isDeleted ? "Silindi (Soft Delete)" : "Aktif")</span>
                                    </span>
                                    @if (isDeleted && item.DeletedAt.HasValue)
                                    {
                                        <div class="text-[10px] text-ink-soft/70 mt-1" id="deleted-at-@item.EntityID">
                                            @item.DeletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-[10px] text-ink-soft/70 mt-1 hidden" id="deleted-at-@item.EntityID"></div>
                                    }
                                </td>

                                <!-- İşlemler (Üç Nokta Menüsü) -->
                                <td class="px-6 py-4 text-right">
                                    <div class="relative inline-block text-left" x-data="{ open: false, dropUp: false }" @@click.outside="open = false">
                                        <button type="button" 
                                                @@click="
                                                    const rect = $el.getBoundingClientRect();
                                                    dropUp = (window.innerHeight - rect.bottom) < 180;
                                                    open = !open;
                                                "
                                                :class="open ? 'bg-brand-100 text-brand-700 border-brand-300 ring-2 ring-brand-200' : 'text-ink-soft hover:text-ink bg-card hover:bg-brand-50 border-line'"
                                                class="w-8 h-8 rounded-lg border transition-all cursor-pointer shadow-xs focus:outline-none inline-flex items-center justify-center"
                                                title="İşlemler"
                                                aria-label="Rezervasyon İşlemleri">
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                                <circle cx="12" cy="5" r="1.8"/>
                                                <circle cx="12" cy="12" r="1.8"/>
                                                <circle cx="12" cy="19" r="1.8"/>
                                            </svg>
                                        </button>

                                        <div x-cloak 
                                             x-show="open" 
                                             x-transition:enter="transition ease-out duration-100"
                                             x-transition:enter-start="transform opacity-0 scale-95"
                                             x-transition:enter-end="transform opacity-100 scale-100"
                                             x-transition:leave="transition ease-in duration-75"
                                             x-transition:leave-start="transform opacity-100 scale-100"
                                             x-transition:leave-end="transform opacity-0 scale-95"
                                             :class="dropUp ? 'bottom-full mb-1.5 origin-bottom-right' : 'top-full mt-1.5 origin-top-right'"
                                             class="absolute right-0 w-48 bg-card border border-line rounded-xl shadow-xl py-1 z-30 divide-y divide-line/60">
                                            
                                            <!-- Düzenle -->
                                            <div class="p-1">
                                                <a href="/Reservation/UpdateReservation/@item.EntityID" 
                                                   class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-ink-soft hover:text-brand-700 hover:bg-brand-50 rounded-lg transition-colors group">
                                                    <svg class="w-4 h-4 text-ink-soft group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                                        <path d="M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5m-1.414-9.414a2 2 0 1 1 2.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                                    </svg>
                                                    <span>Düzenle</span>
                                                </a>
                                            </div>

                                            <!-- Soft Delete / Geri Yükle Seçeneği -->
                                            <div class="p-1">
                                                <button type="button" 
                                                        id="toggle-btn-@item.EntityID"
                                                        @@click="open = false; toggleSoftDelete(@item.EntityID, '@item.FirstName.Replace("'", "\\'") @item.LastName.Replace("'", "\\'")')" 
                                                        class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-ink-soft hover:text-brand-700 hover:bg-brand-50 rounded-lg transition-colors group text-left cursor-pointer">
                                                    <svg class="w-4 h-4 text-ink-soft group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                                        <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                    <span id="toggle-action-text-@item.EntityID">@(isDeleted ? "Geri Yükle (Aktifleştir)" : "Soft Delete Uygula")</span>
                                                </button>
                                            </div>

                                            <!-- Kalıcı Olarak Sil -->
                                            <div class="p-1">
                                                <button type="button" 
                                                        @@click="open = false; deletePermanently(@item.EntityID, '@item.FirstName.Replace("'", "\\'") @item.LastName.Replace("'", "\\'")')" 
                                                        class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-bad hover:bg-bad/10 rounded-lg transition-colors group text-left cursor-pointer">
                                                    <svg class="w-4 h-4 text-bad group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                                        <path d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16"/>
                                                    </svg>
                                                    <span>Kalıcı Olarak Sil</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <!-- Boş Durum (Veritabanında Rezervasyon Yoksa) -->
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center">
                                <div class="max-w-sm mx-auto">
                                    <div class="w-12 h-12 rounded-full bg-brand-50 text-brand-600 grid place-items-center mx-auto mb-3">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                            <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                    </div>
                                    <h3 class="font-display text-lg font-bold text-ink">Henüz Rezervasyon Bulunmuyor</h3>
                                    <p class="text-xs text-ink-soft mt-1">
                                        @(currentFilter == "deleted" 
                                            ? "Arşivlenmiş veya soft delete uygulanmış rezervasyon bulunmamaktadır." 
                                            : "Bu filtreye uygun herhangi bir rezervasyon kaydı bulunamadı. Yeni bir rezervasyon ekleyebilirsiniz.")
                                    </p>
                                    <div class="mt-4">
                                        <a href="/Reservation/AddReservation" class="btn btn-primary text-xs shadow-xs">
                                            Yeni Rezervasyon Ekle
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ============ SAYFALAMA (PAGINATION) ============ -->
        @if (Model != null && Model.Any())
        {
            <div class="px-6 py-4 border-t border-line flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-ink-soft bg-card">
                <span>
                    Toplam <strong>@Model.TotalItemCount</strong> rezervasyondan (Sayfa <strong>@Model.PageNumber</strong> / <strong>@Model.PageCount</strong>)
                </span>
                
                <div class="inline-flex items-center gap-1">
                    <!-- Önceki Sayfa Butonu -->
                    @if (Model.HasPreviousPage)
                    {
                        <a href="/Reservation/Index?page=@(Model.PageNumber - 1)&size=@Model.PageSize&filter=@currentFilter" 
                           class="p-1.5 rounded-lg border border-line bg-card hover:bg-brand-50 text-ink-soft transition-colors"
                           title="Önceki Sayfa">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </a>
                    }
                    else
                    {
                        <span class="p-1.5 rounded-lg border border-line bg-card text-ink-soft opacity-35 cursor-not-allowed" title="İlk sayfadasınız">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    }

                    <!-- Sayfa Numaraları -->
                    @for (int i = 1; i <= Model.PageCount; i++)
                    {
                        var isCurrentPage = i == Model.PageNumber;
                        if (i == 1 || i == Model.PageCount || (i >= Model.PageNumber - 1 && i <= Model.PageNumber + 1))
                        {
                            <a href="/Reservation/Index?page=@i&size=@Model.PageSize&filter=@currentFilter" 
                               class="w-7 h-7 rounded-lg text-xs font-semibold grid place-items-center transition-colors @(isCurrentPage ? "bg-brand-500 text-white shadow-xs" : "border border-line bg-card hover:bg-brand-50 text-ink-soft")">
                                @i
                            </a>
                        }
                        else if (i == Model.PageNumber - 2 || i == Model.PageNumber + 2)
                        {
                            <span class="px-1 text-ink-soft">...</span>
                        }
                    }

                    <!-- Sonraki Sayfa Butonu -->
                    @if (Model.HasNextPage)
                    {
                        <a href="/Reservation/Index?page=@(Model.PageNumber + 1)&size=@Model.PageSize&filter=@currentFilter" 
                           class="p-1.5 rounded-lg border border-line bg-card hover:bg-brand-50 text-ink-soft transition-colors"
                           title="Sonraki Sayfa">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </a>
                    }
                    else
                    {
                        <span class="p-1.5 rounded-lg border border-line bg-card text-ink-soft opacity-35 cursor-not-allowed" title="Son sayfadasınız">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    }
                </div>
            </div>
        }
    </div>

</div>

<!-- ============ BİLDİRİM VE AJAX İŞLEMLERİ SCRIPTLERİ ============ -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
        showNotification('@Html.Raw(TempData["SuccessMessage"])', 'success');
        </text>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
        showNotification('@Html.Raw(TempData["ErrorMessage"])', 'error');
        </text>
    }
});

// ============ SOFT DELETE / GERİ YÜKLE TOGGLE (AJAX) ============
async function toggleSoftDelete(id, name) {
    const badge = document.getElementById(`status-badge-${id}`);
    const textEl = document.getElementById(`status-text-${id}`);
    const dateEl = document.getElementById(`deleted-at-${id}`);
    const actionText = document.getElementById(`toggle-action-text-${id}`);
    const row = document.getElementById(`reservation-row-${id}`);

    const isCurrentlyDeleted = badge?.getAttribute('data-deleted') === 'true';
    const confirmMessage = isCurrentlyDeleted
        ? `"${name}" rezervasyonunu geri yükleyip aktif duruma getirmek istiyor musunuz?`
        : `"${name}" rezervasyonuna soft delete uygulamak (arşive taşımak) istiyor musunuz?`;

    if (!confirm(confirmMessage)) {
        return;
    }

    // Bekleme göstergesi
    if (badge) {
        badge.style.opacity = '0.5';
    }

    try {
        const formData = new FormData();
        formData.append('id', id);

        const response = await fetch('/Reservation/ToggleSoftDelete', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        const result = await response.json();

        if (result.success) {
            const isNowDeleted = result.isDeleted;

            // Badge durumunu güncelle
            if (badge) {
                badge.style.opacity = '1';
                badge.setAttribute('data-deleted', isNowDeleted ? 'true' : 'false');
                badge.className = `inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold transition-all duration-300 ${
                    isNowDeleted ? 'bg-warn/15 text-warn' : 'bg-ok/15 text-ok'
                }`;
                badge.innerHTML = `
                    <span class="w-1.5 h-1.5 rounded-full ${isNowDeleted ? 'bg-warn' : 'bg-ok animate-pulse'}"></span>
                    <span>${isNowDeleted ? 'Silindi (Soft Delete)' : 'Aktif'}</span>
                `;
            }

            // Satır görünümünü güncelle
            if (row) {
                if (isNowDeleted) {
                    row.classList.add('opacity-75', 'bg-warn/5');
                } else {
                    row.classList.remove('opacity-75', 'bg-warn/5');
                }
                row.classList.add('bg-brand-50/80');
                setTimeout(() => row.classList.remove('bg-brand-50/80'), 700);
            }

            // Menüdeki aksiyon butonunun metnini güncelle
            if (actionText) {
                actionText.textContent = isNowDeleted ? 'Geri Yükle (Aktifleştir)' : 'Soft Delete Uygula';
            }

            // Tarih yazısını güncelle
            if (dateEl) {
                if (isNowDeleted && result.deletedAtText) {
                    dateEl.textContent = result.deletedAtText;
                    dateEl.classList.remove('hidden');
                } else {
                    dateEl.classList.add('hidden');
                }
            }

            // İstatistik sayaçlarını güncelle
            const activeStat = document.getElementById('stat-active-count');
            const softDeletedStat = document.getElementById('stat-soft-deleted-count');

            if (activeStat && softDeletedStat) {
                let currentActive = parseInt(activeStat.textContent.trim(), 10) || 0;
                let currentDeleted = parseInt(softDeletedStat.textContent.trim(), 10) || 0;

                if (isNowDeleted) {
                    activeStat.textContent = Math.max(0, currentActive - 1);
                    softDeletedStat.textContent = currentDeleted + 1;
                } else {
                    activeStat.textContent = currentActive + 1;
                    softDeletedStat.textContent = Math.max(0, currentDeleted - 1);
                }
            }

            showNotification(result.message, 'success');
        } else {
            if (badge) badge.style.opacity = '1';
            showNotification(result.message || 'İşlem gerçekleştirilemedi.', 'error');
        }
    } catch (err) {
        console.error('ToggleSoftDelete hatası:', err);
        if (badge) badge.style.opacity = '1';
        showNotification('Sunucuyla iletişim kurulurken bir hata oluştu.', 'error');
    }
}

// ============ KALICI SİL (AJAX) ============
async function deletePermanently(id, name) {
    if (!confirm(`DİKKAT: "${name}" rezervasyonunu veritabanından KALICI OLARAK silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!`)) {
        return;
    }

    const row = document.getElementById(`reservation-row-${id}`);
    if (row) {
        row.style.opacity = '0.4';
        row.style.pointerEvents = 'none';
    }

    try {
        const formData = new FormData();
        formData.append('id', id);
        formData.append('permanent', 'true');

        const response = await fetch('/Reservation/DeleteReservation', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        const result = await response.json();

        if (result.success) {
            if (row) {
                row.style.transition = 'all 0.4s ease';
                row.style.opacity = '0';
                row.style.transform = 'translateX(20px)';
                setTimeout(() => {
                    row.remove();
                    const tbody = document.querySelector('tbody');
                    if (tbody && tbody.querySelectorAll('tr[id^="reservation-row-"]').length === 0) {
                        window.location.reload();
                    }
                }, 400);
            }

            // Toplam sayacı düşür
            const totalStat = document.getElementById('stat-total-count');
            if (totalStat) {
                let currentTotal = parseInt(totalStat.textContent.trim(), 10) || 0;
                totalStat.textContent = Math.max(0, currentTotal - 1);
            }

            showNotification(result.message, 'success');
        } else {
            if (row) {
                row.style.opacity = '1';
                row.style.pointerEvents = 'auto';
            }
            showNotification(result.message || 'Silme işlemi sırasında hata oluştu.', 'error');
        }
    } catch (err) {
        console.error('Kalıcı silme hatası:', err);
        if (row) {
            row.style.opacity = '1';
            row.style.pointerEvents = 'auto';
        }
        showNotification('Sunucuyla iletişim kurulurken bir hata oluştu.', 'error');
    }
}

// ============ BİLDİRİM TOAST ============
function showNotification(message, type = 'success') {
    const isSuccess = type === 'success';
    const toast = document.createElement('div');
    toast.className = `fixed bottom-6 right-6 z-50 flex items-center gap-2.5 px-4 py-3 rounded-xl shadow-lg border text-sm font-medium transition-all duration-300 transform translate-y-4 opacity-0 ${
        isSuccess ? 'bg-card border-ok/30 text-ok' : 'bg-card border-bad/30 text-bad'
    }`;
    toast.innerHTML = `
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="${isSuccess ? 'M5 13l4 4L19 7' : 'M6 18L18 6M6 6l12 12'}" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>${message}</span>
    `;
    document.body.appendChild(toast);

    requestAnimationFrame(() => {
        toast.classList.remove('translate-y-4', 'opacity-0');
    });

    setTimeout(() => {
        toast.classList.add('translate-y-4', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
    }, 3500);
}
</script>
