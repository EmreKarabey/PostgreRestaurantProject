@using CofeeAdmin.Dto.AppRole
@model AddRoleDto

@{
    ViewData["Title"] = "Yeni Rol Ekle";
    Layout = "_Layout";
}

<div class="space-y-8" x-data="{ 
    roleName: '@(Model?.Name ?? "")',
    
    get initial() {
        return this.roleName.trim() ? this.roleName.trim().charAt(0).toUpperCase() : 'R';
    },

    get normalized() {
        return this.roleName.trim() ? this.roleName.trim().toUpperCase() : 'YENİ_ROL';
    },

    get isAdmin() {
        const n = this.roleName.toLowerCase();
        return n.includes('admin') || n.includes('yönetici') || n.includes('super');
    },

    get isManager() {
        const n = this.roleName.toLowerCase();
        return n.includes('manager') || n.includes('müdür') || n.includes('şef');
    },

    get isStaff() {
        const n = this.roleName.toLowerCase();
        return n.includes('barista') || n.includes('kasiyer') || n.includes('garson');
    }
}">

    <!-- ============ ÜST BAŞLIK VE GERİ DÖNÜŞ ALANI ============ -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-3 border-b border-line/70">
        <div>
            <div class="flex items-center gap-3">
                <a href="/Role/Index" 
                   class="p-2 rounded-lg border border-line bg-card hover:bg-brand-50 text-ink-soft hover:text-ink transition-colors"
                   title="Rol Listesine Dön">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
                <h1 class="font-display text-3xl font-bold tracking-tight text-ink">Yeni Rol Tanımla</h1>
            </div>
            <p class="text-sm text-ink-soft mt-1 sm:ml-11">
                Sistem kullanıcılarının yetkilendirileceği yeni bir erişim rolü (Admin, Barista, Müdür vb.) oluşturun.
            </p>
        </div>

        <!-- Sağ Aksiyon: Listeye Geri Dön -->
        <div class="shrink-0">
            <a href="/Role/Index" class="btn btn-ghost text-xs">
                <svg class="w-4 h-4 text-ink-soft" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Rol Listesine Dön</span>
            </a>
        </div>
    </div>

    <!-- ============ FORM VE CANLI ÖNİZLEME ALANI (2 KOLON) ============ -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- ============ SOL ALAN: FORM GİRDİLERİ (7 Kolon) ============ -->
        <div class="lg:col-span-7 bg-card border border-line rounded-2xl p-6 sm:p-8 shadow-xs">
            <div class="flex items-center gap-3 pb-5 mb-6 border-b border-line/60">
                <div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-700 grid place-items-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                </div>
                <div>
                    <h2 class="font-display text-lg font-bold text-ink">Rol Bilgileri</h2>
                    <p class="text-xs text-ink-soft">Lütfen tanımlamak istediğiniz rol adını giriniz.</p>
                </div>
            </div>

            <!-- Genel Hata Bildirim Kutusu -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 rounded-xl border border-bad/30 bg-bad/5 p-4 text-sm text-bad flex items-start gap-3">
                    <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <div>
                        <h4 class="font-semibold text-bad mb-1">Kayıt sırasında bir hata oluştu:</h4>
                        <div asp-validation-summary="All" class="text-xs space-y-0.5"></div>
                    </div>
                </div>
            }

            <form method="post" action="/Role/AddRole" class="space-y-6">

                <!-- Rol Adı Input (Flex Addon Deseni) -->
                <div>
                    <label asp-for="Name" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">
                        Rol Adı <span class="text-bad">*</span>
                    </label>

                    <div class="flex items-stretch rounded-xl border border-line bg-card focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-500/20 transition-all overflow-hidden">
                        <!-- Sol İkon Rozeti -->
                        <span class="inline-flex items-center justify-center px-3.5 bg-brand-50/60 text-ink-soft border-r border-line text-xs font-mono font-medium select-none shrink-0">
                            <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                        </span>

                        <!-- Metin Inputu -->
                        <input asp-for="Name"
                               x-model="roleName"
                               type="text"
                               placeholder="Örn: Admin, Barista, Müdür, Kasiyer..."
                               class="w-full bg-transparent px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-soft/40 border-none outline-none focus:outline-none focus:ring-0 shadow-none ring-0"
                               autocomplete="off" />
                    </div>

                    <span asp-validation-for="Name" class="text-xs text-bad mt-1.5 block font-medium"></span>
                    <p class="text-[11px] text-ink-soft mt-1.5">
                        Rol adı sistemde tekil (benzersiz) olmalıdır. Küçük/büyük harf duyarsız olarak kaydedilir.
                    </p>
                </div>

                <!-- Form Butonları -->
                <div class="flex items-center justify-end gap-3 pt-6 border-t border-line/60">
                    <a href="/Role/Index" class="btn btn-ghost text-xs">
                        İptal
                    </a>
                    <button type="submit" class="btn btn-primary text-xs shadow-xs cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                            <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>Rolü Kaydet</span>
                    </button>
                </div>

            </form>
        </div>

        <!-- ============ SAĞ ALAN: CANLI ROL ÖNİZLEMESİ (5 Kolon) ============ -->
        <div class="lg:col-span-5 space-y-6">

            <!-- Canlı Önizleme Kartı -->
            <div class="bg-card border border-line rounded-2xl p-6 shadow-xs relative overflow-hidden">
                <div class="flex items-center justify-between pb-4 border-b border-line/60 mb-5">
                    <span class="text-xs font-semibold text-ink-soft uppercase tracking-wider flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-ok animate-pulse"></span>
                        Canlı Rol Önizlemesi
                    </span>
                    <span class="text-[11px] font-mono font-medium text-ink-soft bg-paper px-2 py-0.5 rounded border border-line">
                        Preview
                    </span>
                </div>

                <!-- Önizleme Gövdesi -->
                <div class="flex items-center gap-4 p-4 rounded-xl border border-line bg-paper/60">
                    <!-- Avatar Rozeti -->
                    <div class="w-12 h-12 rounded-xl font-display font-bold text-lg border grid place-items-center shrink-0 transition-colors"
                         :class="{
                            'bg-bad/15 text-bad border-bad/30': isAdmin,
                            'bg-warn/15 text-warn border-warn/30': isManager,
                            'bg-ok/15 text-ok border-ok/30': isStaff,
                            'bg-brand-100 text-brand-700 border-brand-200': !isAdmin && !isManager && !isStaff
                         }"
                         x-text="initial">
                        R
                    </div>

                    <!-- Rol Adı ve Durum -->
                    <div class="min-w-0 flex-1">
                        <h3 class="font-display font-bold text-ink text-lg truncate" 
                            x-text="roleName.trim() || 'Yeni Rol Adı'">
                            Yeni Rol Adı
                        </h3>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-brand-50 text-ink border border-line truncate"
                                  x-text="normalized">
                                YENİ_ROL
                            </span>
                            <span class="text-[11px] font-medium"
                                  :class="{
                                      'text-bad font-semibold': isAdmin,
                                      'text-warn font-semibold': isManager,
                                      'text-ok font-semibold': isStaff,
                                      'text-ink-soft': !isAdmin && !isManager && !isStaff
                                  }"
                                  x-text="isAdmin ? 'Tam Yetki' : isManager ? 'Yönetici' : isStaff ? 'Personel' : 'Standart'">
                                Standart
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Yetki Düzeyi Açıklaması -->
                <div class="mt-4 p-3.5 rounded-xl border border-line/60 bg-paper/30 text-xs text-ink-soft space-y-1.5">
                    <div class="flex items-center justify-between text-[11px]">
                        <span class="text-ink font-medium">Sistem Kod Adı:</span>
                        <span class="font-mono text-ink-soft" x-text="normalized">YENİ_ROL</span>
                    </div>
                    <div class="flex items-center justify-between text-[11px]">
                        <span class="text-ink font-medium">Erişim Türü:</span>
                        <span class="font-mono text-brand-700 font-semibold">RBAC (Role-Based)</span>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
