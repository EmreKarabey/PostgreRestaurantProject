@{
	ViewData["Title"] = "Dashboard";
	Layout = "_Layout";
}

<div class="dashboard-page w-full space-y-8">

	<!-- ============ DASHBOARD ANA SAYFA ============ -->
	<section class="space-y-8">

		<!-- Üst Başlık & Hızlı İşlemler -->
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<h2 class="font-display text-3xl font-bold tracking-tight">Yönetim Paneli &amp; Rezervasyonlar</h2>
				<p class="text-ink-soft mt-1">Restoranınızın anlık rezervasyon durumunu ve menü yönetimini takip edin.</p>
			</div>
			
		</div>

		<!-- Gelişmiş İstatistik Kartları (3'lü Grid) -->
		<div class="grid gap-5 sm:grid-cols-3">

			<!-- Toplam Rezervasyon -->
			<article class="rounded-2xl bg-ink text-brand-50 p-6 shadow-sm flex flex-col justify-between relative overflow-hidden">
				<div class="absolute -right-4 -bottom-4 w-28 h-28 bg-brand-500/10 rounded-full blur-xl pointer-events-none"></div>
				<div>
					<div class="flex items-center justify-between">
						<p class="text-sm text-brand-100/80 font-medium">Toplam Rezervasyon</p>
						<span class="text-xs bg-white/10 px-2 py-0.5 rounded text-brand-50 font-semibold">Aktif</span>
					</div>
					<!-- SİGNALR İLE GÜNCELLENECEK ALAN -->
					<p id="reservationCount" class="font-display text-3xl font-bold mt-3">0</p>
				</div>
				<div class="mt-4 pt-4 border-t border-white/10 flex items-center justify-between text-xs">
					<span class="text-brand-100/70">Onaylı Masa Rezervasyonları</span>
					<span class="font-bold text-emerald-300">Sistem Aktif</span>
				</div>
			</article>

			<!-- Toplam Ürün Sayısı -->
			<article class="rounded-2xl bg-card border border-line p-6 shadow-sm flex flex-col justify-between">
				<div>
					<div class="flex items-center justify-between">
						<p class="text-sm text-ink-soft font-medium">Menüdeki Ürünler</p>
						<svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M6 3v8a3 3 0 0 0 3 3v7M9 3v6M12 3v8a3 3 0 0 1-3 3M18 3c-2 2-3 5-3 8h3v10" stroke-linecap="round" /></svg>
					</div>
					<!-- SİGNALR İLE GÜNCELLENECEK ALAN -->
					<p id="totalProductsCount" class="font-display text-3xl font-bold mt-3">0</p>
				</div>
				<div class="mt-4 pt-4 border-t border-line flex items-center justify-between text-xs text-ink-soft">
					<span>Aktif Ürün Çeşidi</span>
					<span class="font-bold text-brand-700">Ürünler</span>
				</div>
			</article>

			<!-- Toplam Kategori Sayısı -->
			<article class="rounded-2xl bg-card border border-line p-6 shadow-sm flex flex-col justify-between">
				<div>
					<div class="flex items-center justify-between">
						<p class="text-sm text-ink-soft font-medium">Kategoriler</p>
						<svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10" stroke-linecap="round" /></svg>
					</div>
					<!-- SİGNALR İLE GÜNCELLENECEK ALAN -->
					<p id="totalCategoriesCount" class="font-display text-3xl font-bold mt-3">0</p>
				</div>
				<div class="mt-4 pt-4 border-t border-line flex items-center justify-between text-xs text-ink-soft">
					<span>Menü Kategorileri</span>
					<span class="font-bold text-brand-700">Kategoriler</span>
				</div>
			</article>

		</div>

		<!-- Grafikler ve Hızlı İşlemler Grid -->
		<div class="grid gap-5 lg:grid-cols-2">

			<!-- Daire Grafiği (Kategori / Ürün Dağılımı) -->
			<article class="rounded-2xl bg-card border border-line p-6 shadow-sm flex flex-col">
				<div class="mb-4">
					<h3 class="font-display text-lg font-semibold">Kategoriye Göre Ürün Dağılımı</h3>
					<p class="text-xs text-ink-soft mt-0.5">Sistemdeki ürünlerin kategorilere göre oransal durumu</p>
				</div>
				<div class="flex-1 relative min-h-[220px] flex items-center justify-center">
					<canvas id="categoryPieChart"></canvas>
				</div>
			</article>

			<!-- Entity Odaklı Hızlı İşlemler -->
			<article class="rounded-2xl bg-card border border-line p-6 shadow-sm flex flex-col">
				<div class="mb-4">
					<h3 class="font-display text-lg font-semibold">Hızlı İşlemler</h3>
					<p class="text-xs text-ink-soft mt-0.5">Sık kullanılan yönetim modüllerine hızlı erişim</p>
				</div>
				<div class="grid grid-cols-2 gap-4 flex-1">

					<a href="/Product/AddProduct" class="flex flex-col items-center justify-center gap-2 p-4 rounded-xl border border-line hover:border-brand-400 hover:bg-brand-50/50 transition-all group">
						<div class="w-10 h-10 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center group-hover:scale-110 transition-transform">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</div>
						<span class="text-sm font-medium text-ink">Yeni Ürün Ekle</span>
					</a>

					<a href="/Category/AddCategory" class="flex flex-col items-center justify-center gap-2 p-4 rounded-xl border border-line hover:border-brand-400 hover:bg-brand-50/50 transition-all group">
						<div class="w-10 h-10 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center group-hover:scale-110 transition-transform">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</div>
						<span class="text-sm font-medium text-ink">Yeni Kategori Ekle</span>
					</a>

					<a href="/Reservation/Index" class="flex flex-col items-center justify-center gap-2 p-4 rounded-xl border border-line hover:border-brand-400 hover:bg-brand-50/50 transition-all group">
						<div class="w-10 h-10 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center group-hover:scale-110 transition-transform">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</div>
						<span class="text-sm font-medium text-ink">Rezervasyon Listesi</span>
					</a>

					<a href="/Product/Index" class="flex flex-col items-center justify-center gap-2 p-4 rounded-xl border border-line hover:border-brand-400 hover:bg-brand-50/50 transition-all group">
						<div class="w-10 h-10 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center group-hover:scale-110 transition-transform">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 10h16M4 14h16M4 18h16" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</div>
						<span class="text-sm font-medium text-ink">Tüm Menü</span>
					</a>

				</div>
			</article>

		</div>

		<!-- Son Rezervasyonlar Tablosu -->
		@await Component.InvokeAsync("_DashboardMenuListComponent")

	</section>

</div>

@section Scripts {
	<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

	<script>
		document.addEventListener('DOMContentLoaded', function () {

			// --- 1. CHART.JS KURULUMU ---
			// Grafiği dışarıda tanımlıyoruz ki SignalR'dan veri gelince update() edebilelim.
			const ctx = document.getElementById('categoryPieChart').getContext('2d');
			const brandColors = ['#d4a373', '#faedcd', '#fefae0', '#e9edc9', '#ccd5ae', '#8e9aaf', '#cbc0d3'];

			let categoryPieChart = new Chart(ctx, {
				type: 'doughnut',
				data: {
					labels: [], // Başlangıçta boş, SignalR dolduracak
					datasets: [{
						data: [], // Başlangıçta boş, SignalR dolduracak
						backgroundColor: brandColors,
						borderWidth: 2,
						borderColor: '#ffffff',
						hoverOffset: 6
					}]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					cutout: '65%',
					plugins: {
						legend: { position: 'right', labels: { font: { family: "'Inter', sans-serif", size: 12 }, usePointStyle: true, padding: 20 } },
						tooltip: { callbacks: { label: function(context) { return (context.label || '') + ': ' + (context.parsed || 0) + ' Ürün'; } } }
					}
				}
			});

			// Mobil ilk açılışta kapsayıcı ölçüsü CSS yüklenmeden önce alınabiliyor.
			// Sayfa/font ölçüleri oturduğunda layout ve grafiği tekrar hesapla.
			const chartContainer = ctx.canvas.parentElement;
			const refreshDashboardLayout = () => requestAnimationFrame(() => requestAnimationFrame(() => {
				window.dispatchEvent(new Event('resize'));
				categoryPieChart.resize();
			}));
			refreshDashboardLayout();
			window.addEventListener('load', refreshDashboardLayout, { once: true });
			window.addEventListener('pageshow', refreshDashboardLayout);
			if (document.fonts?.ready) document.fonts.ready.then(refreshDashboardLayout);
			setTimeout(refreshDashboardLayout, 250);
			if (window.ResizeObserver && chartContainer) {
				new ResizeObserver(refreshDashboardLayout).observe(chartContainer);
			}

			// --- 2. SİGNALR BAĞLANTISI VE DİNLEME ---
			const connection = new signalR.HubConnectionBuilder()
				.withUrl("/signalrhub")
				.configureLogging(signalR.LogLevel.Information)
				.build();

			async function start() {
				try {
					await connection.start();
					await connection.invoke("SendStatcis");
				} catch (err) {
					setTimeout(start, 5000);
				}
			};

			connection.onclose(async () => {
				await start();
			});

			connection.on("ReservationCount", (count) => {
				document.getElementById("reservationCount").innerText = count;
			});

			connection.on("TotalProducts", (count) => {
				document.getElementById("totalProductsCount").innerText = count;
			});

			connection.on("TotalCategories", (count) => {
				document.getElementById("totalCategoriesCount").innerText = count;
			});

			// YENİ: GRAFİK VERİSİNİ DİNLEME
			connection.on("CategoriesList", (categoriesArray) => {
				// categoriesArray, C#'tan gelen JSON dizisidir: [{ categoryName: "Tatlılar", productCount: 4 }, ...]

				// Gelen diziden sadece isimleri ayırıp labels dizisi oluşturuyoruz
				const newLabels = categoriesArray.map(c => c.categoryName);

				// Gelen diziden sadece sayıları ayırıp data dizisi oluşturuyoruz
				// (Eğer C# tarafında ProductCount'u henüz eklemediysen hata vermemesi için || 1 ile sahte veri atıyoruz)
				const newData = categoriesArray.map(c => c.productCount || 1);

				// Chart'ın verilerini güncelle ve yeniden çizdir
				categoryPieChart.data.labels = newLabels;
				categoryPieChart.data.datasets[0].data = newData;
				categoryPieChart.update();
			});

			start();
		});
	</script>
}
