@model List<Application.Features.RestaurantTable.Queries.GetActiveTableList.GetActiveTableListDto>

@{
	ViewData["Title"] = "Rezervasyon Yap";
	Layout = "_Layout";
}

<!-- ========================================== -->
<!-- 1. MİMARİ KROKİ CSS (12 MASALI TEK KAPI)   -->
<!-- ========================================== -->
<style>
	.restaurant-map-container {
		display: none;
		background: #f4f4f4;
		padding: 40px 10px;
		margin-top: 20px;
		border-radius: 8px;
	}

	.floor-plan {
		background-color: #fdfdfd;
		background-image: linear-gradient(#f0f0f0 1px, transparent 1px), linear-gradient(90deg, #f0f0f0 1px, transparent 1px);
		background-size: 25px 25px;
		border: 6px solid #2c3e50;
		border-radius: 4px;
		position: relative;
		width: 100%;
		max-width: 950px;
		min-height: 587px;
		margin: 0 auto;
		padding: 0;
		box-shadow: 0 15px 40px rgba(0,0,0,0.1);
		overflow: hidden;
	}

	/* Sabit Mimari Alanlar */
	.fp-window {
		position: absolute;
		left: 1.5%;
		top: 5%;
		bottom: 8%;
		width: 4.5%;
		border-right: 3px double #bdc3c7;
		background: rgba(236, 240, 241, 0.3);
		display: flex;
		align-items: center;
		justify-content: center;
		writing-mode: vertical-rl;
		text-orientation: upright;
		font-size: 11px;
		color: #95a5a6;
		letter-spacing: 8px;
	}

	.fp-kitchen {
		position: absolute;
		left: 15%;
		right: 3%;
		top: 5%;
		height: 16%;
		border: 2px solid #7f8c8d;
		background: repeating-linear-gradient(45deg, #f9f9f9, #f9f9f9 10px, #f1f1f1 10px, #f1f1f1 20px);
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 600;
		color: #7f8c8d;
		letter-spacing: 3px;
		font-size: 14px;
		border-radius: 2px;
	}

	/* Kapı Tasarımı */
	.door-cutout {
		position: absolute;
		bottom: -6px;
		left: 50%;
		transform: translateX(-50%);
		width: 140px;
		height: 6px;
		background: #fdfdfd;
	}

	.door-label {
		position: absolute;
		bottom: 15px;
		left: 50%;
		transform: translateX(-50%);
		font-weight: bold;
		color: #2c3e50;
		font-size: 14px;
		letter-spacing: 2px;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	/* Masa ve Sandalyeler */
	.table-cell {
		position: absolute;
		width: 110px;
		height: 110px;
		transform: translate(-50%, -50%);
	}

	.table-box {
		position: relative;
		width: 110px;
		height: 110px;
		cursor: pointer;
		transition: transform 0.2s ease;
	}

	.table-surface {
		position: absolute;
		top: 22px;
		left: 22px;
		right: 22px;
		bottom: 22px;
		background: #e6ccb2;
		border: 2px solid #555;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		z-index: 2;
		transition: all 0.3s;
		box-shadow: inset 0 0 10px rgba(0,0,0,0.05);
		transform: rotate(var(--table-rotation, 0deg));
	}

		.table-surface span {
			font-weight: 700;
			font-size: 15px;
			color: #333;
		}

		.table-surface small {
			font-size: 11px;
			color: #555;
		}

	.shape-round {
		border-radius: 50%;
	}

	.shape-rect {
		border-radius: 4px;
	}

	.chair {
		position: absolute;
		width: 26px;
		height: 20px;
		background: #fff;
		border: 2px solid #555;
		border-radius: 12px 12px 2px 2px;
		transition: all 0.3s;
		z-index: 1;
	}

	.chair-top {
		top: 0;
		left: 42px;
		transform: rotate(0deg);
	}

	.chair-bottom {
		bottom: 0;
		left: 42px;
		transform: rotate(180deg);
	}

	.chair-left {
		left: 0;
		top: 45px;
		transform: rotate(-90deg);
		width: 20px;
		height: 26px;
		border-radius: 2px 12px 12px 2px;
	}

	.chair-right {
		right: 0;
		top: 45px;
		transform: rotate(90deg);
		width: 20px;
		height: 26px;
		border-radius: 12px 2px 2px 12px;
	}

	/* Seçim / Hover Durumları */
	.table-box:hover {
		transform: scale(1.04);
	}

		.table-box:hover .table-surface, .table-box:hover .chair {
			border-color: #28a745;
			background-color: #f0fff0;
		}

	.table-box.selected .table-surface, .table-box.selected .chair {
		border-color: #c9a131;
		background-color: #fff9e6;
		border-width: 3px;
	}

		.table-box.selected .table-surface span, .table-box.selected .table-surface small {
			color: #c9a131;
		}

	.table-box.locked {
		cursor: not-allowed;
		opacity: 0.7;
	}

		.table-box.locked .table-surface, .table-box.locked .chair {
			border-color: #e74c3c;
			background-color: #fdfefe;
		}

			.table-box.locked .table-surface span {
				color: #e74c3c;
				text-decoration: line-through;
			}

	.map-legend {
		margin-top: 30px;
		display: flex;
		justify-content: center;
		gap: 25px;
		font-weight: 500;
		font-size: 14px;
	}

	.legend-item {
		display: flex;
		align-items: center;
		gap: 8px;
		color: #555;
	}

	.legend-color {
		width: 20px;
		height: 20px;
		border: 2px solid #555;
		border-radius: 3px;
	}

	.color-free {
		background: #e6ccb2;
	}

	.color-selected {
		background: #fff9e6;
		border-color: #c9a131;
	}

	.color-locked {
		background: #fdfefe;
		border-color: #e74c3c;
	}

	/* Estetik Özel Masa Seçim Kartı (Switch Tasarımı) */
	.table-select-card {
		background: #ffffff;
		border: 2px dashed #c9a131;
		border-radius: 8px;
		padding: 15px 20px;
		display: inline-flex;
		align-items: center;
		gap: 15px;
		transition: all 0.3s ease;
		box-shadow: 0 4px 10px rgba(201, 161, 49, 0.08);
	}

		.table-select-card:hover {
			background: #fffdf5;
			border-color: #b58d27;
			box-shadow: 0 6px 15px rgba(201, 161, 49, 0.15);
		}

	@@media (max-width: 700px) {
		.floor-plan { min-height: 500px; }
		.table-cell { transform: translate(-50%, -50%) scale(.72); }
		.fp-window { font-size: 8px; letter-spacing: 3px; }
		.fp-kitchen { font-size: 9px; letter-spacing: 1px; }
		.door-label { font-size: 10px; letter-spacing: 1px; }
	}

	@@media (max-width: 767px) {
		.reservation-page-section { padding: 36px 0 48px !important; }
		.restaurant-map-container { padding: 18px 12px; overflow: hidden; }
		.floor-plan-viewport { width: 100%; overflow-x: auto; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; padding: 0 0 10px; touch-action: pan-x pan-y; scrollbar-width: thin; scrollbar-color: #c9a131 #e4e4e4; }
		.floor-plan-viewport::-webkit-scrollbar { height: 8px; }
		.floor-plan-viewport::-webkit-scrollbar-track { background: #e4e4e4; border-radius: 8px; }
		.floor-plan-viewport::-webkit-scrollbar-thumb { background: #c9a131; border-radius: 8px; }
		.floor-plan { width: 680px; max-width: none; min-height: 500px; }
		.table-cell { transform: translate(-50%, -50%) scale(.72); }
		.map-legend { justify-content: flex-start; flex-wrap: wrap; gap: 12px 18px; margin-top: 18px; font-size: 12px; }
		.table-select-card { display: flex; width: 100%; justify-content: center; padding: 12px; gap: 10px; }
		.reservation-page-section .form-control { font-size: 16px; }
		.reservation-page-section .btn-reserve { width: 100%; max-width: 420px; padding-left: 16px !important; padding-right: 16px !important; font-size: 1rem !important; }
		.restaurant-map-container > .text-center { margin-bottom: 14px !important; }
		.restaurant-map-container > .text-center h4 { font-size: 20px; line-height: 1.35; }
		.restaurant-map-container > .text-center p { margin-bottom: 8px; font-size: 14px; line-height: 1.5; }
	}
</style>

<!-- ========================================== -->
<!-- 2. ÜST GÖRSEL VE BAŞLIK                    -->
<!-- ========================================== -->
<section class="topSingleBkg topPageBkg">
	<div class="item-content-bkg">
		<div class="item-img" style="background-image:url('@Url.Content("~/image/restaurant3.jpg")');"></div>
		<div class="inner-desc">
			<h1 class="post-title single-post-title">Rezervasyon Yapın</h1>
			<span class="post-subtitle"> Unutulmaz bir deneyim için yerinizi ayırtın</span>
		</div>
	</div>
</section>

<!-- ========================================== -->
<!-- 3. REZERVASYON FORMU VE KROKİ ALANI        -->
<!-- ========================================== -->
<section class="menu-1col-content reservation-page-section" style="padding-top: 60px; padding-bottom: 80px;">
	<div class="container">
		<div class="row">
			<div class="col-md-10 offset-md-1">

				<div class="categ-name text-center mb-5">
					<h2>Rezervasyon Formu</h2>
				</div>

				<!-- Başarı Mesajı Alanı -->
				@if (TempData["SuccessMessage"] != null || ViewBag.SucessMessage != null)
				{
					<div class="alert alert-success text-center mb-4" style="font-weight:bold; font-size:1.1rem;">
						@(TempData["SuccessMessage"] ?? ViewBag.SucessMessage)
					</div>
				}
				@if (TempData["ErrorMessage"] != null)
				{
					<div class="alert alert-danger text-center mb-4" role="alert" style="font-weight:600;">
						@TempData["ErrorMessage"]
					</div>
				}

				<form action="/Reservation/Index" method="POST" id="reservationForm">
					<!-- ASP.NET Core Güvenlik Tokeni -->
					@Html.AntiForgeryToken()

					<div class="row">
						<div class="col-md-6 form-group mb-4">
							<label for="FirstName">Adınız *</label>
							<input type="text" class="form-control" id="FirstName" name="FirstName" required placeholder="Adınızı giriniz">
						</div>
						<div class="col-md-6 form-group mb-4">
							<label for="LastName">Soyadınız *</label>
							<input type="text" class="form-control" id="LastName" name="LastName" required placeholder="Soyadınızı giriniz">
						</div>
					</div>

					<div class="row">
						<div class="col-md-6 form-group mb-4">
							<label for="Email">E-posta Adresiniz *</label>
							<input type="email" class="form-control" id="Email" name="Email" required placeholder="ornek@mail.com">
						</div>
						<div class="col-md-6 form-group mb-4">
							<label for="PhoneNumber">Telefon Numaranız *</label>
							<input type="tel" class="form-control" id="PhoneNumber" name="PhoneNumber" required placeholder="05XX XXX XX XX">
						</div>
					</div>

					<div class="row">
						<div class="col-md-6 form-group mb-4">
							<label for="ReservationDate">Tarih ve Saat *</label>
							<input type="datetime-local" class="form-control" id="ReservationDate" name="ReservationDate" required>
						</div>
						<div class="col-md-6 form-group mb-4">
							<label for="NumberOfPeople">Kişi Sayısı *</label>
							<input type="number" class="form-control" id="NumberOfPeople" name="NumberOfPeople" min="1" max="20" required placeholder="Örn: 2">
						</div>
					</div>

					<!-- ESTETİK ÖZEL MASA SEÇİM ALANI -->
					<div class="form-group mb-4 text-center">
						<div class="table-select-card">
							<i class="fas fa-chair" style="color: #c9a131; font-size: 1.4rem;"></i>
							<div class="custom-control custom-switch m-0">
								<input type="checkbox" class="custom-control-input" id="toggleTableMap">
								<label class="custom-control-label" for="toggleTableMap" style="cursor: pointer; color: #2c3e50; font-weight: 600; font-size: 1.05rem;">
									Krokiden Özel Masa Seçmek İstiyorum
								</label>
							</div>
						</div>
					</div>

					<input type="hidden" id="TableNumber" name="TableNumber" value="">

					<!-- KROKİ ALANI -->
					<div class="restaurant-map-container" id="mapContainer">
						<div class="text-center mb-4">
							<h4>Restoran Mimari Kat Planı</h4>
							<p class="text-muted">Giriş kapısı ve pencereleri referans alarak masanızı seçin.</p>
							<p class="text-muted d-md-none"><small>Diğer masaları görmek için kat planını sağa veya sola kaydırın.</small></p>
						</div>

						<div class="floor-plan-viewport">
						<div class="floor-plan">
							<div class="fp-window">CAM / MANZARA</div>
							<div class="fp-kitchen"><i class="fas fa-sink" style="margin-right:10px;"></i> MUTFAK VE BAR SERVİS ALANI</div>

							@foreach (var table in Model)
							{
								var shapeClass = table.Shape == "square" ? "shape-rect" : "shape-round";
								<div class="table-cell" style="left:@((table.PositionX * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%;top:@((table.PositionY * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%">
									<div class="table-box" data-table-id="@table.TableNumber" data-capacity="@($"{table.Capacity} Kişi")">
										<div class="chair chair-top"></div><div class="chair chair-bottom"></div>
										<div class="chair chair-left"></div><div class="chair chair-right"></div>
										<div class="table-surface @shapeClass" style="--table-rotation:@(table.Rotation)deg">
										<span>M@(table.TableNumber)</span><small>@table.Capacity Kişi</small>
										</div>
									</div>
								</div>
							}

							<div class="door-cutout"></div>
							<div class="door-label"><i class="fas fa-door-open"></i> GİRİŞ / ÇIKIŞ KAPISI</div>
						</div>
						</div>

						<div class="map-legend">
							<div class="legend-item"><div class="legend-color color-free"></div> Boş (Müsait)</div>
							<div class="legend-item"><div class="legend-color color-selected"></div> Sizin Seçiminiz</div>
							<div class="legend-item"><div class="legend-color color-locked"></div> Dolu / İşlemde</div>
						</div>
					</div>

					<div class="text-center mt-5">
						<button type="submit" class="btn btn-reserve btn-lg" style="background-color: #c9a131; color: white; border: none; padding: 12px 50px; font-weight: bold; border-radius: 4px; font-size: 1.2rem;">Rezervasyonu Tamamla</button>
					</div>
				</form>

			</div>
		</div>
	</div>
</section>

<!-- ========================================== -->
<!-- 4. SAF JAVASCRIPT & SIGNALR ENTEGRASYONU   -->
<!-- ========================================== -->
@section Scripts {
	<!-- SignalR Kütüphanesi -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

	<script>
		document.addEventListener("DOMContentLoaded", function() {
			let reservationSubmitting = false;
			const toggle = document.getElementById('toggleTableMap');
			const mapContainer = document.getElementById('mapContainer');
			const tableNumberInput = document.getElementById('TableNumber');
			const reservationDateInput = document.getElementById('ReservationDate');
			const tables = document.querySelectorAll('.table-box');
			let activeReservations = [];
			let selectedCacheDate = null;

			const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
			const cacheRequestHeaders = {
				'X-Requested-With': 'XMLHttpRequest',
				'RequestVerificationToken': antiForgeryToken
			};

			function getReservationDateForCache() {
				const date = reservationDateInput.value ? new Date(reservationDateInput.value) : null;
				return date && Number.isFinite(date.getTime()) ? date.toISOString() : null;
			}

			function releaseTableCache(tableNumber, reservationDate = selectedCacheDate) {
				if (!tableNumber || !reservationDate) return Promise.resolve();
				return fetch('/Reservation/ReleaseCache?TableNumber=' + encodeURIComponent(tableNumber)
					+ '&ReservationDate=' + encodeURIComponent(reservationDate), {
					method: 'POST',
					headers: cacheRequestHeaders,
					keepalive: true
				}).catch(error => console.error('Masa kilidi bırakılamadı:', error));
			}

			async function syncSelectedTableCacheToDate() {
				const tableNumber = tableNumberInput.value;
				const nextDate = getReservationDateForCache();
				if (!tableNumber || !nextDate || nextDate === selectedCacheDate) return;

				const previousDate = selectedCacheDate;
				try {
					const response = await fetch('/Reservation/RegisterCache?TableNumber=' + encodeURIComponent(tableNumber)
						+ '&ReservationDate=' + encodeURIComponent(nextDate), {
						method: 'POST',
						headers: cacheRequestHeaders
					});
					const data = await response.json();
					if (!data.success) {
						await releaseTableCache(tableNumber, previousDate);
						document.querySelector('.table-box.selected')?.classList.remove('selected');
						tableNumberInput.value = '';
						selectedCacheDate = null;
						alert(data.message);
						return;
					}

					selectedCacheDate = nextDate;
					if (previousDate) await releaseTableCache(tableNumber, previousDate);
				} catch (error) {
					console.error('Masa kilidi güncellenemedi:', error);
				}
			}

			// Masayı yalnızca seçilen rezervasyon saatiyle 4 saatlik kullanım aralığı çakışıyorsa dolu göster.
			function refreshTableAvailability() {
				const selectedTime = reservationDateInput.value ? new Date(reservationDateInput.value).getTime() : NaN;
				const hasSelectedTime = Number.isFinite(selectedTime);
				const reservationDurationMs = 4 * 60 * 60 * 1000;

				tables.forEach(table => {
					table.classList.remove('locked');
					table.querySelector('small').innerText = table.getAttribute('data-capacity');
				});

				if (!hasSelectedTime) return;

				activeReservations.forEach(item => {
					const tableNumber = item.tableNumber ?? item.TableNumber;
					const reservationDate = item.reservationDate ?? item.ReservationDate;
					const reservationStart = new Date(reservationDate).getTime();
					if (!tableNumber || !Number.isFinite(reservationStart)) return;

					const overlaps = selectedTime < reservationStart + reservationDurationMs
						&& selectedTime + reservationDurationMs > reservationStart;
					if (!overlaps) return;

					const lockedTable = document.querySelector(`.table-box[data-table-id="${tableNumber}"]`);
					if (lockedTable) {
						lockedTable.classList.add('locked');
						lockedTable.querySelector('small').innerText = 'Dolu';
					}
				});

				const selectedTable = document.querySelector('.table-box.selected');
				if (selectedTable?.classList.contains('locked')) {
					const id = selectedTable.getAttribute('data-table-id');
					const lockedDate = selectedCacheDate;
					selectedTable.classList.remove('selected');
					tableNumberInput.value = '';
					selectedCacheDate = null;
					releaseTableCache(id, lockedDate);
					if (!reservationSubmitting) {
						alert(`Masa ${id}, seçtiğiniz tarih ve saat aralığında dolu. Lütfen başka bir masa seçin.`);
					}
				}
			}

			reservationDateInput.addEventListener('input', refreshTableAvailability);
			reservationDateInput.addEventListener('change', function() {
				refreshTableAvailability();
				syncSelectedTableCacheToDate();
			});

			// 1. Kroki Aç/Kapat
			toggle.addEventListener('change', function() {
				if(this.checked) {
					mapContainer.style.display = 'block';
				} else {
					mapContainer.style.display = 'none';
					const selectedTable = document.querySelector('.table-box.selected');
					if (selectedTable) {
						releaseTableCache(selectedTable.getAttribute('data-table-id'), selectedCacheDate);
						selectedTable.classList.remove('selected');
						tableNumberInput.value = '';
						selectedCacheDate = null;
					}
				}
			});

			// 2. Masa Seçimi ve Redis Cache İsteği
			tables.forEach(table => {
				table.addEventListener('click', function() {
					if (!reservationDateInput.value || !Number.isFinite(new Date(reservationDateInput.value).getTime())) {
						alert('Önce rezervasyon tarih ve saatini seçin.');
						reservationDateInput.focus();
						return;
					}

					if(this.classList.contains('locked')) {
						alert('Bu masa, seçtiğiniz tarih ve saat aralığında dolu.');
						return;
					}

					const tableNumber = this.getAttribute('data-table-id');
					const previousTableNumber = tableNumberInput.value;
					const previousCacheDate = selectedCacheDate;
					const reservationDate = getReservationDateForCache();
					if (previousTableNumber === tableNumber) return;

					fetch('/Reservation/RegisterCache?TableNumber=' + encodeURIComponent(tableNumber)
						+ '&ReservationDate=' + encodeURIComponent(reservationDate), {
						method: 'POST',
						headers: cacheRequestHeaders
					})
					.then(response => response.json())
					.then(data => {
						if(data.success) {
							tables.forEach(t => t.classList.remove('selected'));
							this.classList.add('selected');
							tableNumberInput.value = tableNumber;
							selectedCacheDate = reservationDate;
							if (previousTableNumber) releaseTableCache(previousTableNumber, previousCacheDate);
						} else {
							alert(data.message);
						}
					})
					.catch(error => {
						console.error('Hata:', error);
						alert('Sunucuyla bağlantı kurulurken bir hata oluştu.');
					});
				});
			});

			// 3. Form gönderiminde tarayıcıdaki seçim değerini temizle; cache kilidini handler kayıt sonrası bırakır.
			document.getElementById('reservationForm').addEventListener('submit', function() {
				reservationSubmitting = true;
			});

			// 4. SIGNALR İLE GERÇEK ZAMANLI MASA DURUMU
			const connection = new signalR.HubConnectionBuilder()
				.withUrl("/signalrhub")
				.build();

			connection.on("GetActiveTables", function (activeTables) {
				activeReservations = Array.isArray(activeTables) ? activeTables : [];
				refreshTableAvailability();
			});

			// SignalR bağlantısını başlat ve ilk verileri çek
			connection.start().then(function () {
				connection.invoke("ViewActiveReservation").catch(function (err) {
					return console.error(err.toString());
				});
			}).catch(function (err) {
				return console.error(err.toString());
			});
		});
	</script>
}
